# Optional integrations; never put real credentials in this file.
JHIVE_ENV=development
JHIVE_LOG_LEVEL=INFO
# Exchange sandbox credentials can be added here locally in .env only.
# EXCHANGE_API_KEY=
# EXCHANGE_API_SECRET=

# Optional Google, GitHub, and Microsoft sign-in. Register these callback URLs in each
# provider's app registration. For a local run use the URLs below.
JHIVE_BASE_URL=http://127.0.0.1:8765
# JHIVE_GOOGLE_CLIENT_ID=
# JHIVE_GOOGLE_CLIENT_SECRET=
# JHIVE_GITHUB_CLIENT_ID=
# JHIVE_GITHUB_CLIENT_SECRET=
# JHIVE_MICROSOFT_CLIENT_ID=
# JHIVE_MICROSOFT_CLIENT_SECRET=

# Apple sign-in needs an Apple Developer Services ID and signed client secret;
# Apple authentication is not wired up yet.

# Optional email one-time-code sign-in (STARTTLS is enabled by default).
# JHIVE_SMTP_HOST=
# JHIVE_SMTP_PORT=587
# JHIVE_SMTP_USER=
# JHIVE_SMTP_PASSWORD=
# JHIVE_SMTP_FROM=
# JHIVE_SMTP_STARTTLS=true
